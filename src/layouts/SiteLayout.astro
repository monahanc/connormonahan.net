---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Connor Monahan',
  description = 'The research, projects, and other notes from Connor.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="Connor Monahan" href="/feed.xml" />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: light;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        color: #202938;
        background: #f3f5f8;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        --color-muted: #667085;
        --color-border: #e5e9f0;
        --color-link: #2457a6;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        line-height: 1.7;
      }

      a {
        color: var(--color-link);
        text-decoration: none;
      }

      a:hover,
      a:focus-visible {
        text-decoration: underline;
      }

      header,
      main,
      footer {
        width: min(100% - 2rem, 820px);
        margin-inline: auto;
      }

      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.35rem 0;
      }

      header a {
        color: #202938;
      }

      .site-title {
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: -0.025em;
      }

      nav {
        display: flex;
        gap: 0.35rem;
      }

      nav a {
        padding: 0.45rem 0.8rem;
        border-radius: 0.5rem;
        color: #475467;
        font-size: 0.95rem;
        font-weight: 550;
      }

      nav a:hover,
      nav a:focus-visible {
        background: #e9edf4;
        color: #202938;
        text-decoration: none;
      }

      main {
        min-height: 70vh;
        padding: clamp(1.5rem, 5vw, 3rem);
        border: 1px solid var(--color-border);
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 12px 36px rgb(16 24 40 / 5%);
      }

      h1,
      h2,
      h3 {
        color: #202938;
        line-height: 1.25;
      }

      h1 {
        margin: 0 0 1.25rem;
        font-size: clamp(2rem, 5vw, 2.5rem);
        letter-spacing: -0.04em;
      }

      h2 {
        margin-top: 2.5rem;
        font-size: 1.4rem;
        letter-spacing: -0.02em;
      }

      img {
        max-width: 100%;
        height: auto;
      }

      .profile {
        width: 180px;
        margin: 0 0 1rem;
        border: 4px solid #f0f3f8;
        border-radius: 50%;
      }

      .post-list {
        display: grid;
        gap: 0.75rem;
        margin: 1.25rem 0;
        padding: 0;
        list-style: none;
      }

      .post-list-item {
        position: relative;
        display: grid;
        gap: 0.15rem;
        padding: 1rem 1.15rem;
        border: 1px solid var(--color-border);
        border-radius: 0.7rem;
        background: #fff;
        transition:
          border-color 140ms ease,
          background-color 140ms ease,
          transform 140ms ease;
      }

      .post-list-item:hover {
        transform: translateY(-1px);
        border-color: #c8d4e5;
        background: #fafbfc;
      }

      .post-list-item > a {
        width: fit-content;
        color: #202938;
        font-size: 1.08rem;
        font-weight: 650;
        line-height: 1.4;
      }

      .post-list-item > a:hover,
      .post-list-item > a:focus-visible {
        color: var(--color-link);
      }

      .post-date {
        display: block;
        color: var(--color-muted);
        font-size: 0.84rem;
        font-variant-numeric: tabular-nums;
      }

      article {
        color: #344054;
      }

      article h1 {
        margin-bottom: 0.35rem;
      }

      article > .post-date {
        margin-bottom: 2rem;
      }

      article h2 {
        margin-top: 2.25rem;
      }

      article img {
        border-radius: 0.4rem;
      }

      article blockquote {
        margin-inline: 0;
        padding: 0.25rem 1rem;
        border-left: 3px solid #c8d4e5;
        color: var(--color-muted);
      }

      article pre {
        overflow-x: auto;
        padding: 1rem;
        border: 1px solid var(--color-border);
        border-radius: 0.6rem;
        background: #f7f8fa;
      }

      article code {
        font-size: 0.9em;
      }

      article iframe {
        max-width: 100%;
      }

      footer {
        margin-top: 1.25rem;
        padding: 1.5rem 0 2.25rem;
        border-top: 1px solid var(--color-border);
        color: var(--color-muted);
        font-size: 0.88rem;
      }

      .footer-main,
      .footer-bottom,
      .footer-links {
        display: flex;
        align-items: center;
      }

      .footer-main {
        justify-content: space-between;
        gap: 1rem;
      }

      .footer-intro,
      .footer-bottom p {
        margin: 0;
      }

      .footer-intro strong {
        display: block;
        color: #344054;
        font-size: 0.95rem;
      }

      .footer-links {
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .footer-links a {
        padding: 0.4rem 0.7rem;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        background: #fff;
        color: #475467;
        font-weight: 550;
        transition:
          border-color 140ms ease,
          background-color 140ms ease,
          color 140ms ease;
      }

      .footer-links a:hover,
      .footer-links a:focus-visible {
        border-color: #c8d4e5;
        background: #f8f9fb;
        color: var(--color-link);
        text-decoration: none;
      }

      .footer-bottom {
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px solid var(--color-border);
        font-size: 0.8rem;
      }

      @media (max-width: 560px) {
        header {
          align-items: flex-start;
          flex-direction: column;
          gap: 0.5rem;
        }

        nav {
          margin-left: -0.8rem;
        }

        main {
          width: min(100% - 1rem, 820px);
          padding: 1.25rem;
          border-radius: 0.75rem;
        }

        .post-list-item {
          padding: 0.85rem 0.95rem;
        }

        footer {
          padding-bottom: 1.5rem;
        }

        .footer-main,
        .footer-bottom {
          align-items: flex-start;
          flex-direction: column;
        }

        .footer-main {
          gap: 0.9rem;
        }

        .footer-bottom {
          gap: 0.25rem;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <a class="site-title" href="/">Connor Monahan</a>
      <nav aria-label="Main navigation">
        <a href="/research.html">Research</a>
        <a href="/posts.html">Posts</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-main">
        <p class="footer-intro">
          <strong>Connor Monahan</strong>
          Software, research, and projects.
        </p>
        <nav class="footer-links" aria-label="Social links">
          <a href="https://github.com/cmastudios">GitHub</a>
          <a href="https://www.linkedin.com/in/connor-monahan-a23318146/">LinkedIn</a>
          <a href="mailto:cma2714@gmail.com">Email</a>
        </nav>
      </div>
      <div class="footer-bottom">
        <p>© {new Date().getFullYear()} Connor Monahan</p>
      </div>
    </footer>
  </body>
</html>
