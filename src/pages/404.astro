---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="404 | Connor Monahan">
  <section class="not-found">
    <h1>404</h1>
    <p><strong>Page not found :(</strong></p>
    <p>The requested page could not be found.</p>
  </section>
</SiteLayout>

<style>
  .not-found {
    margin: 2rem auto;
    max-width: 600px;
    text-align: center;
  }

  .not-found h1 {
    margin: 2rem 0;
    font-size: 4rem;
    line-height: 1;
  }
</style>
